#!/usr/bin/env bash
# Local verification gate (docs/VERIFICATION.md, level 1).
# Exit code 0 means EVERY step below is clean. Never weaken a step to make it
# pass (no --allow-warnings, no skipped suites); fix the code or ask the owner.
set -u
cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.rokit/bin:$PATH"

for tool in stylua selene rojo luau-lsp lune; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "MISSING TOOL: $tool (run: rokit install)"
		exit 2
	fi
done
if [ ! -d Packages ]; then
	echo "MISSING Packages/ (run: wally install)"
	exit 2
fi

failures=()
step() { printf '\n=== %s\n' "$1"; }
run() {
	local name="$1"
	shift
	if ! "$@"; then failures+=("$name"); fi
}

step "stylua (format)"
run stylua stylua --check src tests

step "selene (lint; warnings are failures)"
run selene selene src

step "rojo sourcemap"
run sourcemap rojo sourcemap default.project.json -o sourcemap.json

step "type check (luau-lsp analyze)"
DEFS=".cache/globalTypes.None.d.luau"
if [ ! -f "$DEFS" ]; then
	mkdir -p .cache
	curl -fsSL -o "$DEFS" \
		"https://raw.githubusercontent.com/JohnnyMorganz/luau-lsp/1.70.1/scripts/globalTypes.None.d.luau" ||
		{ echo "cannot download Roblox type definitions"; failures+=("types-definitions"); rm -f "$DEFS"; }
fi
if [ -f "$DEFS" ]; then
	run types luau-lsp analyze --definitions="$DEFS" --sourcemap=sourcemap.json \
		--ignore "Packages/**" --ignore "**/Packages/**" src
fi

step "no pasted copies of game code in tests"
if grep -rniE "inlined (implementation|copy)|matches src/" tests --include=*.luau; then
	failures+=("pasted-copies")
fi

step "rojo build"
mkdir -p build
run build rojo build -o build/game.rbxl

step "tests (lune)"
run tests lune run tests/run

echo
if [ ${#failures[@]} -eq 0 ]; then
	echo "CHECK PASSED"
	exit 0
fi
echo "CHECK FAILED: ${failures[*]}"
exit 1
